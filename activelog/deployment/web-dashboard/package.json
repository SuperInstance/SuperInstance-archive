{
  "name": "activelog-deployment-dashboard",
  "version": "1.0.0",
  "description": "Web-based dashboard for ActiveLog deployment management",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server.js",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "install-client": "cd client && npm install"
  },
  "dependencies": {
    "express": "^4.18.0",
    "express-ws": "^5.0.2",
    "cors": "^2.8.5",
    "body-parser": "^1.20.0",
    "multer": "^1.4.5",
    "ws": "^8.13.0",
    "chokidar": "^3.5.3",
    "node-cron": "^3.0.2",
    "axios": "^1.4.0",
    "jsonwebtoken": "^9.0.0",
    "bcryptjs": "^2.4.3",
    "helmet": "^7.0.0",
    "rate-limiter-flexible": "^2.4.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.0",
    "concurrently": "^8.2.0"
  },
  "keywords": [
    "activelog",
    "deployment",
    "dashboard",
    "monitoring",
    "aws",
    "terraform"
  ],
  "author": "ActiveLog Team",
  "license": "MIT"
}