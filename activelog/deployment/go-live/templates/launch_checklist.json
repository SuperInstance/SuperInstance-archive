  "validation_commands": {
    "overall_system_health": [
      "curl -f https://activelog.com/health",
      "curl -f https://api.activelog.com/health", 
      "curl -f https://auth.activelog.com/health",
      "curl -f https://files.activelog.com/health",
      "curl -f https://legal.activelog.com/health"
    ],
    "database_connectivity": [
      "python3 -c \"import psycopg2; conn = psycopg2.connect(host='prod-db', database='activelog'); print('DB OK')\"",
      "redis-cli -h prod-redis ping"
    ],
    "ssl_certificates": [
      "openssl s_client -connect activelog.com:443 -servername activelog.com < /dev/null | openssl x509 -noout -dates"
    ],
    "dns_resolution": [
      "dig +short activelog.com",
      "dig +short api.activelog.com", 
      "dig +short www.activelog.com"
    ]
  },
  "rollback_procedures": {
    "dns_rollback": {
      "description": "Rollback DNS changes to previous configuration",
      "steps": [
        "Identify previous DNS configuration",
        "Update Route 53 records to previous values", 
        "Wait for DNS propagation",
        "Verify rollback successful"
      ],
      "estimated_time": "15 minutes"
    },
    "application_rollback": {
      "description": "Rollback application to previous version",
      "steps": [
        "Identify previous stable version",
        "Scale down current deployment",
        "Deploy previous version",
        "Run health checks",
        "Update load balancer targets"
      ],
      "estimated_time": "30 minutes"
    },
    "database_rollback": {
      "description": "Rollback database changes",
      "steps": [
        "Stop application writes to database",
        "Restore from backup snapshot",
        "Verify data integrity", 
        "Update connection strings",
        "Resume application operation"
      ],
      "estimated_time": "60 minutes"
    }
  },
