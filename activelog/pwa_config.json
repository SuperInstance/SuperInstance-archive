{
  "service_worker": {
    "cache_strategy": "cache_first",
    "offline_fallbacks": true,
    "background_sync": true,
    "push_notifications": false
  },
  "manifest": {
    "display": "standalone",
    "start_url": "/",
    "theme_color": "#2196F3",
    "background_color": "#ffffff",
    "icons": [
      {
        "src": "icon-192.png",
        "sizes": "192x192",
        "type": "image/png"
      },
      {
        "src": "icon-512.png",
        "sizes": "512x512",
        "type": "image/png"
      }
    ]
  },
  "performance": {
    "lazy_loading": true,
    "code_splitting": true,
    "tree_shaking": true,
    "compression": "gzip"
  }
}