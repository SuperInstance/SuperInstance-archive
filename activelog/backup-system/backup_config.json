{
  "project_name": "activelog",
  "backup_settings": {
    "compression": {
      "algorithm": "gzip",
      "level": 6,
      "chunk_size_mb": 950
    },
    "split_threshold_mb": 1000,
    "max_backup_size_gb": 10
  },
  "exclusion_patterns": [
    "node_modules/",
    ".git/objects/",
    ".git/logs/",
    "*.log",
    "*.tmp",
    "*.temp",
    ".DS_Store",
    "Thumbs.db",
    "coverage/",
    "dist/",
    "build/",
    ".cache/",
    ".next/",
    ".nuxt/",
    "*.lock",
    "package-lock.json",
    "yarn.lock",
    "target/",
    "*.jar",
    "*.war",
    "*.ear",
    "*.class",
    "*.pyc",
    "__pycache__/",
    "*.egg-info/",
    ".venv/",
    ".env.local",
    ".env.development",
    ".env.production",
    "*.swp",
    "*.swo",
    "*~",
    ".backup/",
    "backup-*/",
    "*.backup",
    "dumps/",
    "*.sql.gz",
    "*.dump",
    ".terraform/",
    "terraform.tfstate*",
    "*.tfvars",
    ".vagrant/",
    "Vagrantfile.local",
    "docker-compose.override.yml",
    ".dockerignore.local",
    "*.pid",
    "*.seed",
    "*.pid.lock",
    ".nyc_output/",
    ".sass-cache/",
    "connect.lock",
    "typings/",
    "lib-cov/",
    "*.orig",
    ".grunt/",
    "bower_components/",
    ".lock-wscript",
    "jspm_packages/",
    ".npm/",
    ".eslintcache",
    ".rpt2_cache/",
    ".rts2_cache_cjs/",
    ".rts2_cache_es/",
    ".rts2_cache_umd/",
    ".node_repl_history",
    "*.tsbuildinfo",
    ".vscode/settings.json",
    ".idea/workspace.xml",
    ".idea/tasks.xml",
    "*.iml",
    "out/",
    "gen/",
    ".metadata/",
    "bin/",
    "tmp/",
    "*.class",
    "hs_err_pid*"
  ],
  "include_patterns": [
    "**/*.js",
    "**/*.jsx",
    "**/*.ts",
    "**/*.tsx",
    "**/*.json",
    "**/*.md",
    "**/*.yml",
    "**/*.yaml",
    "**/*.xml",
    "**/*.html",
    "**/*.css",
    "**/*.scss",
    "**/*.sass",
    "**/*.less",
    "**/*.sql",
    "**/*.sh",
    "**/*.py",
    "**/*.rb",
    "**/*.php",
    "**/*.java",
    "**/*.go",
    "**/*.rs",
    "**/*.cpp",
    "**/*.c",
    "**/*.h",
    "**/*.hpp",
    "**/*.cs",
    "**/*.vb",
    "**/*.swift",
    "**/*.kt",
    "**/*.scala",
    "**/Dockerfile*",
    "**/.gitignore",
    "**/.gitattributes",
    "**/README*",
    "**/LICENSE*",
    "**/CHANGELOG*",
    "**/*.env.example",
    "**/*.config.js",
    "**/*.config.json",
    "**/*.conf",
    "**/Makefile",
    "**/*.mk",
    "**/*.cmake",
    "**/CMakeLists.txt",
    "**/*.gradle",
    "**/build.gradle*",
    "**/pom.xml",
    "**/Cargo.toml",
    "**/Cargo.lock",
    "**/requirements*.txt",
    "**/Pipfile*",
    "**/setup.py",
    "**/setup.cfg",
    "**/pyproject.toml",
    "**/*.toml",
    "**/*.ini",
    "**/*.cfg"
  ],
  "destinations": [
    {
      "type": "s3",
      "name": "primary_s3",
      "enabled": true,
      "priority": 1,
      "config": {
        "bucket": "${S3_BACKUP_BUCKET}",
        "region": "${AWS_REGION:-us-east-1}",
        "prefix": "activelog-backups/",
        "storage_class": "STANDARD_IA",
        "encryption": true
      }
    },
    {
      "type": "github_releases",
      "name": "github_fallback",
      "enabled": true,
      "priority": 2,
      "config": {
        "repository": "${GITHUB_REPOSITORY}",
        "max_release_assets": 10,
        "asset_prefix": "backup-",
        "draft": false,
        "prerelease": false
      }
    },
    {
      "type": "local",
      "name": "local_backup",
      "enabled": true,
      "priority": 3,
      "config": {
        "path": "/tmp/activelog-backups",
        "max_local_backups": 5,
        "compress": true
      }
    }
  ],
  "retention_policies": {
    "daily": {
      "keep_count": 7,
      "pattern": "daily-*"
    },
    "weekly": {
      "keep_count": 4,
      "pattern": "weekly-*"
    },
    "monthly": {
      "keep_count": 12,
      "pattern": "monthly-*"
    },
    "yearly": {
      "keep_count": 3,
      "pattern": "yearly-*"
    }
  },
  "notifications": {
    "webhook": {
      "enabled": true,
      "url": "${WEBHOOK_URL}",
      "on_success": true,
      "on_failure": true,
      "timeout": 30
    },
    "email": {
      "enabled": false,
      "smtp_server": "${SMTP_SERVER}",
      "smtp_port": 587,
      "username": "${SMTP_USERNAME}",
      "password": "${SMTP_PASSWORD}",
      "from": "${BACKUP_EMAIL_FROM}",
      "to": ["${BACKUP_EMAIL_TO}"],
      "on_success": false,
      "on_failure": true
    },
    "slack": {
      "enabled": false,
      "webhook_url": "${SLACK_WEBHOOK_URL}",
      "channel": "#backups",
      "on_success": true,
      "on_failure": true
    }
  },
  "validation": {
    "verify_checksums": true,
    "test_restore": false,
    "max_validation_time_minutes": 30
  },
  "monitoring": {
    "log_level": "INFO",
    "log_file": "/var/log/activelog-backup.log",
    "metrics_endpoint": "${METRICS_ENDPOINT}",
    "health_check_url": "${HEALTH_CHECK_URL}"
  }
}