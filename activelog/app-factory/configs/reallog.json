{
  "name": "RealLog.ai",
  "version": "1.0.0",
  "title": "RealLog.ai - Professional Video Editing Suite",
  "description": "Final Cut Pro-like interface for professional video editing",
  "favicon": "/assets/reallog/favicon.ico",
  "domain": "reallog.ai",
  "devPort": 3004,
  "theme": "pro-dark",
  "layout": "video-editor",
  "monetization": {
    "type": "subscription",
    "tiers": ["creator", "professional", "studio"],
    "trialPeriod": "30d"
  },
  "features": {
    "timelineEditing": true,
    "multiTrackAudio": true,
    "colorGrading": true,
    "visualEffects": true,
    "motionGraphics": true,
    "audioMixing": true,
    "collaboration": true,
    "cloudRendering": true,
    "aiEnhancement": true,
    "multicamEditing": true,
    "proxyWorkflow": true,
    "assetManagement": true
  },
  "modules": [
    {
      "name": "timeline",
      "component": "TimelineEditorModule",
      "props": {
        "enableMagneticTimeline": true,
        "enableKeyframes": true,
        "enableNestedSequences": true,
        "enableMulticam": true,
        "trackTypes": ["video", "audio", "text", "graphics"],
        "maxTracks": 99
      }
    },
    {
      "name": "viewer",
      "component": "VideoViewerModule",
      "props": {
        "enableFullscreen": true,
        "enableWaveformDisplay": true,
        "enableVectorscope": true,
        "enableHistogram": true,
        "enableSafeAreas": true,
        "playbackModes": ["realtime", "proxy", "offline"]
      }
    },
    {
      "name": "colorGrading",
      "component": "ColorGradingModule",
      "props": {
        "enableLUTs": true,
        "enableColorWheels": true,
        "enableCurves": true,
        "enableScopes": true,
        "enableMatching": true,
        "enableMasks": true
      }
    },
    {
      "name": "effects",
      "component": "EffectsModule",
      "props": {
        "enableTransitions": true,
        "enableFilters": true,
        "enableGenerators": true,
        "enableCompositing": true,
        "enableKeyframing": true,
        "enablePlugins": true
      }
    },
    {
      "name": "audio",
      "component": "AudioEditorModule",
      "props": {
        "enableMultitrack": true,
        "enableMixing": true,
        "enableEffects": true,
        "enableNoiseReduction": true,
        "enableSpatialAudio": true,
        "enableSurround": true
      }
    },
    {
      "name": "assetBrowser",
      "component": "AssetBrowserModule",
      "props": {
        "enableTagging": true,
        "enableSearch": true,
        "enablePreview": true,
        "enableMetadata": true,
        "enableProxyGeneration": true,
        "supportedFormats": ["mov", "mp4", "prores", "dnxhd", "avchd"]
      }
    },
    {
      "name": "collaboration",
      "component": "CollaborationModule",
      "props": {
        "enableRealTimeEditing": true,
        "enableComments": true,
        "enableVersionControl": true,
        "enableApprovals": true,
        "enableSharing": true
      }
    },
    {
      "name": "rendering",
      "component": "RenderingModule",
      "props": {
        "enableCloudRendering": true,
        "enableBackground": true,
        "enableQueue": true,
        "enableFormats": ["h264", "h265", "prores", "dnxhd"],
        "enableCustomSettings": true
      }
    }
  ],
  "aiModels": [
    {
      "name": "auto-editor",
      "type": "video-processing",
      "endpoint": "/ai/auto-editing",
      "features": ["scene-detection", "shot-selection", "rhythm-matching"]
    },
    {
      "name": "speech-enhancer",
      "type": "audio-processing",
      "endpoint": "/ai/speech-enhancement",
      "features": ["noise-reduction", "clarity-boost", "loudness-matching"]
    },
    {
      "name": "color-matcher",
      "type": "image-processing",
      "endpoint": "/ai/color-matching",
      "features": ["auto-correction", "shot-matching", "style-transfer"]
    },
    {
      "name": "content-analyzer",
      "type": "video-analysis",
      "endpoint": "/ai/content-analysis",
      "features": ["object-detection", "face-recognition", "scene-understanding"]
    },
    {
      "name": "upscaler",
      "type": "super-resolution",
      "endpoint": "/ai/video-upscaling",
      "features": ["resolution-enhancement", "detail-recovery", "noise-reduction"]
    }
  ],
  "auth": {
    "providers": ["email", "google", "apple", "adobe"],
    "requireEmailVerification": true,
    "enableTwoFactor": true,
    "sessionDuration": "12h",
    "rememberDevice": true,
    "enableTeamAccounts": true
  },
  "dataSync": {
    "enabled": true,
    "cloudProvider": "activelog-cloud-pro",
    "encryption": "enterprise-grade",
    "conflictResolution": "version-control",
    "syncFrequency": "realtime",
    "offlineSupport": true,
    "enableVersioning": true,
    "storageQuota": "unlimited"
  },
  "settings": {
    "privacy": {
      "dataRetentionPeriod": "indefinite",
      "enableDataExport": true,
      "enableDataDeletion": true,
      "showDataUsage": true,
      "enableWatermarking": true
    },
    "notifications": {
      "enablePush": true,
      "enableEmail": true,
      "enableSlack": true,
      "enableRenderComplete": true,
      "enableCollaborationUpdates": true,
      "enableSystemAlerts": true
    },
    "appearance": {
      "defaultTheme": "pro-dark",
      "enableCustomization": true,
      "enableColorSchemes": true,
      "enableWorkspaceLayouts": true
    },
    "performance": {
      "enableGPUAcceleration": true,
      "enableProxyMedia": true,
      "enableBackgroundRendering": true,
      "cacheSize": "50GB",
      "enableOptimizedPlayback": true
    }
  },
  "customModules": [
    {
      "name": "motion-graphics",
      "path": "/modules/reallog/MotionGraphics.js"
    },
    {
      "name": "advanced-compositing",
      "path": "/modules/reallog/AdvancedCompositing.js"
    },
    {
      "name": "workflow-automation",
      "path": "/modules/reallog/WorkflowAutomation.js"
    }
  ],
  "integrations": [
    {
      "name": "adobe-creative-cloud",
      "enabled": true,
      "syncProjects": true
    },
    {
      "name": "davinci-resolve",
      "enabled": true,
      "projectExchange": true
    },
    {
      "name": "frame-io",
      "enabled": true,
      "reviewAndApproval": true
    },
    {
      "name": "youtube",
      "enabled": true,
      "directUpload": true
    },
    {
      "name": "vimeo",
      "enabled": true,
      "directUpload": true
    },
    {
      "name": "dropbox",
      "enabled": true,
      "assetSync": true
    },
    {
      "name": "google-drive",
      "enabled": true,
      "assetSync": true
    }
  ],
  "analytics": {
    "provider": "professional",
    "enableUserTracking": true,
    "enablePerformanceTracking": true,
    "enableErrorTracking": true,
    "enableUsageTracking": true,
    "respectDoNotTrack": false
  },
  "hardware": {
    "enableGPUAcceleration": true,
    "supportedGPUs": ["nvidia", "amd", "intel"],
    "enableMetalSupport": true,
    "enableCUDASupport": true,
    "enableOpenCLSupport": true,
    "minimumRAM": "16GB",
    "recommendedRAM": "64GB",
    "storageRequirements": "SSD recommended"
  }
}