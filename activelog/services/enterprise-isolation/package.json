{
  "name": "activelog-enterprise-isolation",
  "version": "1.0.0",
  "description": "Enterprise-grade air-gapped deployment system with embassy-level security",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "install": "node scripts/installation/air-gap-installer.js",
    "setup": "node scripts/setup/enterprise-setup.js",
    "backup": "node scripts/backup/backup-manager.js",
    "restore": "node scripts/restore/restore-manager.js",
    "audit": "node scripts/audit/audit-runner.js",
    "compliance": "node scripts/compliance/compliance-checker.js",
    "update": "node scripts/update/offline-updater.js",
    "security-scan": "node scripts/security/security-scanner.js",
    "encrypt": "node scripts/security/data-encryptor.js",
    "test": "jest --coverage",
    "test:security": "jest tests/security/",
    "test:integration": "jest tests/integration/",
    "lint": "eslint src/ scripts/ --fix",
    "docker:build": "docker build -t activelog-enterprise .",
    "docker:run": "docker run -d -p 8309:8309 activelog-enterprise",
    "k8s:deploy": "kubectl apply -f kubernetes/",
    "prepare-offline": "node scripts/package/offline-packager.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "express-rate-limit": "^6.8.1",
    "helmet": "^7.0.0",
    "cors": "^2.8.5",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0",
    "redis": "^4.6.8",
    "winston": "^3.10.0",
    "express-validator": "^7.0.1",
    "joi": "^17.9.2",
    "node-cron": "^3.0.2",
    "express-session": "^1.17.3",
    "passport": "^0.6.0",
    "passport-local": "^1.0.0",
    "passport-ldap": "^1.0.8",
    "passport-saml": "^3.2.4",
    "crypto": "^1.0.1",
    "node-forge": "^1.3.1",
    "argon2": "^0.31.0",
    "speakeasy": "^2.0.0",
    "qrcode": "^1.5.3",
    "sqlite3": "^5.1.6",
    "better-sqlite3": "^8.7.0",
    "pg": "^8.11.3",
    "mysql2": "^3.6.0",
    "ldapjs": "^3.0.3",
    "node-vault": "^0.10.2",
    "tar": "^6.1.15",
    "archiver": "^5.3.1",
    "unzipper": "^0.10.11",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.32.5",
    "uuid": "^9.0.0",
    "moment": "^2.29.4",
    "ip": "^1.1.8",
    "geoip-lite": "^1.4.7",
    "express-brute": "^1.0.1",
    "express-brute-redis": "^0.0.1",
    "helmet-csp": "^3.4.0",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "rotating-file-stream": "^3.1.1",
    "node-cache": "^5.1.2",
    "bull": "^4.11.3",
    "bull-board": "^4.10.0",
    "pm2": "^5.3.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.6.2",
    "supertest": "^6.3.3",
    "eslint": "^8.47.0",
    "eslint-config-security": "^1.4.0",
    "npm-audit": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "enterprise",
    "air-gapped",
    "security",
    "embassy-grade",
    "offline-deployment",
    "data-sovereignty",
    "compliance",
    "audit-trails",
    "role-based-access",
    "backup-systems"
  ],
  "author": "ActiveLog Enterprise Security Team",
  "license": "PROPRIETARY",
  "private": true,
  "repository": {
    "type": "git",
    "url": "private-repository"
  },
  "config": {
    "security_level": "embassy-grade",
    "deployment_type": "air-gapped",
    "compliance_standards": ["NIST", "ISO27001", "SOC2", "GDPR", "HIPAA"],
    "encryption_level": "AES-256-GCM",
    "key_derivation": "PBKDF2-SHA512"
  }
}