{
  "name": "dmlog-stream",
  "version": "1.0.0",
  "description": "DMLog Streaming Tools - OBS overlays, viewer interaction, and stream automation",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "overlay-dev": "webpack serve --config webpack.overlay.config.js --mode development",
    "overlay-build": "webpack --config webpack.overlay.config.js --mode production"
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "ws": "^8.14.2",
    "obs-websocket-js": "^5.0.3",
    "twitch": "^4.6.11",
    "tmi.js": "^1.8.5",
    "canvas": "^2.11.2",
    "sharp": "^0.32.6",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.2",
    "node-twitter-api-v2": "^1.15.2",
    "axios": "^1.5.0",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.0",
    "moment": "^2.29.4",
    "lodash": "^4.17.21",
    "chokidar": "^3.5.3",
    "sqlite3": "^5.1.6",
    "typeorm": "^0.3.17",
    "multer": "^1.4.5-lts.1",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "express-rate-limit": "^6.10.0",
    "compression": "^1.7.4"
  },
  "devDependencies": {
    "@types/node": "^20.5.9",
    "@types/express": "^4.17.17",
    "@types/ws": "^8.5.5",
    "@types/uuid": "^9.0.3",
    "@types/lodash": "^4.14.197",
    "@types/multer": "^1.4.7",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/bcryptjs": "^2.4.4",
    "@types/compression": "^1.7.3",
    "typescript": "^5.2.2",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.1",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "html-webpack-plugin": "^5.5.3",
    "css-loader": "^6.8.1",
    "style-loader": "^3.3.3",
    "ts-loader": "^9.4.4",
    "@typescript-eslint/eslint-plugin": "^6.5.0",
    "@typescript-eslint/parser": "^6.5.0",
    "eslint": "^8.48.0",
    "jest": "^29.6.4",
    "@types/jest": "^29.5.4"
  },
  "keywords": [
    "dnd",
    "streaming",
    "obs",
    "overlay",
    "twitch",
    "viewer-interaction",
    "automation"
  ],
  "author": "DMLog Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}