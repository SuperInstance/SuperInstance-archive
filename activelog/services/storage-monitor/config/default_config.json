{
  "thresholds": {
    "rapid_growth_mb": 100,
    "large_file_gb": 1.0,
    "directory_limit_gb": 5.0,
    "disk_usage_warning": 0.8,
    "disk_usage_critical": 0.95,
    "scan_interval_seconds": 60,
    "growth_window_minutes": 5,
    "alert_cooldown_minutes": 15
  },
  "paths_to_monitor": [
    "/home/activeloguser/activelog/services",
    "/home/activeloguser/activelog/checkpoints",
    "/home/activeloguser/activelog/backups",
    "/home/activeloguser/activelog/logs",
    "/home/activeloguser/activelog/pids"
  ],
  "paths_to_exclude": [
    "/home/activeloguser/activelog/services/*/node_modules",
    "/home/activeloguser/activelog/services/*/__pycache__",
    "/home/activeloguser/activelog/services/*/dist",
    "/home/activeloguser/activelog/services/*/build",
    "/home/activeloguser/activelog/services/*/.git",
    "/home/activeloguser/activelog/services/*/logs",
    "/home/activeloguser/activelog/services/*/temp",
    "/home/activeloguser/activelog/services/*/tmp",
    "/home/activeloguser/activelog/services/*/.cache"
  ],
  "remediation": {
    "auto_remediate": true,
    "max_file_size_for_auto_delete_mb": 500,
    "backup_before_delete": true,
    "compress_large_files": true,
    "move_to_quarantine": true,
    "quarantine_dir": "/home/activeloguser/activelog/services/storage-monitor/quarantine",
    "compress_logs_older_than_days": 1,
    "quarantine_retention_days": 7
  },
  "alerts": {
    "enabled": true,
    "log_alerts": true,
    "email_alerts": false,
    "webhook_alerts": false,
    "integration_with_improvement_system": true,
    "alert_thresholds": {
      "critical_growth_mb_per_hour": 200,
      "high_growth_mb_per_hour": 100,
      "medium_growth_mb_per_hour": 50
    }
  },
  "integration": {
    "improvement_system_url": "http://localhost:8500",
    "storage_monitor_url": "http://localhost:8490",
    "health_check_interval_minutes": 5,
    "sync_config_interval_hours": 1,
    "emergency_notification_enabled": true
  },
  "performance": {
    "max_concurrent_scans": 3,
    "scan_timeout_minutes": 15,
    "database_cleanup_interval_hours": 24,
    "metrics_retention_days": 30,
    "log_rotation_size_mb": 100
  },
  "advanced": {
    "enable_machine_learning": false,
    "enable_predictive_analytics": true,
    "enable_anomaly_detection": true,
    "growth_prediction_hours": [1, 6, 24, 168],
    "risk_assessment_weights": {
      "disk_usage": 0.4,
      "growth_rate": 0.3,
      "unresolved_alerts": 0.2,
      "system_load": 0.1
    }
  }
}