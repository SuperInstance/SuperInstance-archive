{
  "name": "@activelog/growth-systems",
  "version": "1.0.0",
  "description": "Comprehensive growth systems for ActiveLog platform",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:seo\" \"npm run dev:blog\" \"npm run dev:forum\"",
    "dev:seo": "next dev -p 3001",
    "dev:blog": "cd blog && npm run dev",
    "dev:forum": "cd forum && npm run dev",
    "build": "npm run build:seo && npm run build:blog && npm run build:forum",
    "build:seo": "next build",
    "build:blog": "cd blog && npm run build",
    "build:forum": "cd forum && npm run build",
    "start": "concurrently \"npm run start:seo\" \"npm run start:blog\" \"npm run start:forum\"",
    "start:seo": "next start -p 3001",
    "start:blog": "cd blog && npm start",
    "start:forum": "cd forum && npm start",
    "generate:sitemap": "node scripts/generate-sitemap.js",
    "generate:content": "node scripts/generate-content.js",
    "generate:tutorials": "node scripts/generate-tutorial-scripts.js",
    "setup:integrations": "node scripts/setup-integrations.js",
    "test": "jest",
    "test:e2e": "playwright test",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "type-check": "tsc --noEmit",
    "analyze": "npm run build && npx @next/bundle-analyzer"
  },
  "keywords": [
    "growth",
    "marketing",
    "seo",
    "referral",
    "email",
    "social",
    "affiliate",
    "onboarding",
    "support",
    "community"
  ],
  "author": "ActiveLog Team",
  "license": "MIT",
  "dependencies": {
    "@next/bundle-analyzer": "^14.0.0",
