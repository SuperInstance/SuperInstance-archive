{
  "name": "dual-interface-system",
  "version": "1.0.0",
  "description": "Age-appropriate dual interface system with seamless UI transformation",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon --exec ts-node src/server.ts",
    "client:dev": "webpack serve --config webpack.dev.js",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "webpack --config webpack.prod.js",
    "test": "jest",
    "lint": "eslint src/**/*.{ts,tsx}",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["dual-interface", "age-detection", "ui-transformation", "kid-safe"],
  "author": "ActiveLog Services",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "compression": "^1.7.4",
    "socket.io": "^4.7.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.14.2",
    "framer-motion": "^10.16.4",
    "styled-components": "^6.0.7",
    "zustand": "^4.4.1",
    "@radix-ui/react-slider": "^1.1.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-dialog": "^1.0.4",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "lucide-react": "^0.263.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "tailwind-merge": "^1.14.0",
    "date-fns": "^2.30.0",
    "natural": "^6.5.0",
    "compromise": "^14.10.0",
    "web-speech-api": "^0.0.1",
    "speech-synthesis-utterance": "^1.0.0",
    "puppeteer": "^21.0.1",
    "content-filter": "^1.1.3",
    "profanity-check": "^1.0.3",
    "readability": "^0.1.1",
    "sentiment": "^5.0.2",
    "bad-words": "^3.0.4",
    "axios": "^1.5.0",
    "cheerio": "^1.0.0-rc.12",
    "node-cache": "^5.1.2",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/cors": "^2.8.13",
    "@types/compression": "^1.7.2",
    "@types/react": "^18.2.20",
    "@types/react-dom": "^18.2.7",
    "@types/node": "^20.5.0",
    "@types/natural": "^5.1.3",
    "@types/cheerio": "^0.22.31",
    "typescript": "^5.1.6",
    "ts-node": "^10.9.1",
    "nodemon": "^3.0.1",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "ts-loader": "^9.4.4",
    "html-webpack-plugin": "^5.5.3",
    "mini-css-extract-plugin": "^2.7.6",
    "css-loader": "^6.8.1",
    "postcss": "^8.4.27",
    "postcss-loader": "^7.3.3",
    "tailwindcss": "^3.3.3",
    "autoprefixer": "^10.4.15",
    "concurrently": "^8.2.0",
    "jest": "^29.6.2",
    "@types/jest": "^29.5.4",
    "ts-jest": "^29.1.1",
    "eslint": "^8.46.0",
    "@typescript-eslint/eslint-plugin": "^6.2.1",
    "@typescript-eslint/parser": "^6.2.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}