{
  "name": "@activelog/print-automation",
  "version": "1.0.0",
  "description": "Manufacturing automation system for 3D printing fleet management and automated workflows",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx --watch src/server.ts",
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "docker:build": "docker build -t activelog/print-automation .",
    "docker:run": "docker run -p 8305:8305 activelog/print-automation"
  },
  "dependencies": {
    "@types/node": "^20.0.0",
    "@types/express": "^4.17.21",
    "@types/uuid": "^9.0.8",
    "@types/node-cron": "^3.0.11",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "uuid": "^9.0.1",
    "axios": "^1.6.2",
    "ws": "^8.14.2",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "node-cron": "^3.0.3",
    "sharp": "^0.32.6",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.3",
    "pdf-lib": "^1.17.1",
    "canvas": "^2.11.2",
    "serialport": "^12.0.0",
    "mqtt": "^5.3.4",
    "ioredis": "^5.3.2",
    "winston": "^3.11.0",
    "dotenv": "^16.3.1",
    "zod": "^3.22.4",
    "joi": "^17.11.0",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "sqlite3": "^5.1.6",
    "better-sqlite3": "^9.2.2",
    "pg": "^8.11.3",
    "drizzle-orm": "^0.29.1",
    "drizzle-kit": "^0.20.7",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/multer": "^1.4.11",
    "@types/ws": "^8.5.10",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/qrcode": "^1.5.5",
    "@types/jest": "^29.5.8",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "supertest": "^6.3.3",
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/activelog/print-automation.git"
  },
  "keywords": [
    "3d-printing",
    "manufacturing",
    "automation",
    "octoprint",
    "fleet-management",
    "quality-control",
    "inventory",
    "packaging",
    "scheduling",
    "optimization"
  ],
