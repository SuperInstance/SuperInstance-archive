{
  "name": "dmlog-visualizer",
  "version": "1.0.0",
  "description": "Advanced game engine integration service for DMLog with battle visualization, voice-to-scene generation, and cinematic rendering",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest",
    "build": "npm run build:client && npm run build:server",
    "build:client": "webpack --mode production",
    "build:server": "babel src -d dist --copy-files",
    "lint": "eslint src/",
    "unreal:build": "node scripts/build-unreal-plugin.js",
    "unity:build": "node scripts/build-unity-package.js",
    "export:models": "node scripts/export-character-models.js",
    "generate:docs": "jsdoc src/ -d docs/"
  },
  "keywords": [
    "dmlog",
    "game-engine",
    "unreal-engine",
    "unity",
    "visualization",
    "battle-renderer",
    "voice-to-scene",
    "cinematic",
    "streaming",
    "ai-narration",
    "video-generation"
  ],
  "author": "ActiveLog Inc.",
  "license": "PROPRIETARY",
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.4",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "winston": "^3.11.0",
    "mongoose": "^8.0.3",
    "redis": "^4.6.10",
    "bull": "^4.12.2",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.1",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.2",
    "three": "^0.158.0",
    "babylonjs": "^6.34.1",
    "cannon-es": "^0.20.0",
    "gsap": "^3.12.2",
    "pixi.js": "^7.3.2",
    "@tensorflow/tfjs-node": "^4.15.0",
    "openai": "^4.20.1",
    "@google-cloud/speech": "^6.0.0",
    "aws-sdk": "^2.1509.0",
    "@google-cloud/text-to-speech": "^5.0.0",
    "web3": "^4.2.2",
    "ethers": "^6.8.1",
    "ipfs-http-client": "^60.0.1",
    "ws": "^8.14.2",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "joi": "^17.11.0",
    "uuid": "^9.0.1",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "axios": "^1.6.2",
    "cheerio": "^1.0.0-rc.12",
    "puppeteer": "^21.6.1",
    "playwright": "^1.40.1",
    "node-gyp": "^10.0.1",
    "canvas": "^2.11.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.56.0",
    "babel-cli": "^6.26.0",
    "babel-preset-env": "^1.7.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "jsdoc": "^4.0.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/activelog/dmlog-visualizer.git"
  },
  "bugs": {
    "url": "https://github.com/activelog/dmlog-visualizer/issues"
  },
  "homepage": "https://dmlog.activelog.com"
}