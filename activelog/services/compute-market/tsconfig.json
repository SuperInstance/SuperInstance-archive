{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "ESNext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@detection/*": ["./src/detection/*"],
      "@isolation/*": ["./src/isolation/*"],
      "@pricing/*": ["./src/pricing/*"],
      "@reputation/*": ["./src/reputation/*"],
      "@payment/*": ["./src/payment/*"],
      "@distribution/*": ["./src/distribution/*"],
      "@monitoring/*": ["./src/monitoring/*"],
      "@sla/*": ["./src/sla/*"],
      "@marketplace/*": ["./src/marketplace/*"],
      "@setup/*": ["./src/setup/*"],
      "@utils/*": ["./src/utils/*"],
      "@types/*": ["./src/types/*"]
    },
    "types": ["node", "jest", "express"]
  },
  "include": [
    "src/**/*",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.spec.ts"
  ],
  "ts-node": {
    "esm": true
  }
}