    "analyze": "node scripts/analyze.js",
    "docs": "jsdoc -c jsdoc.json",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "build": "node scripts/build.js"
  },
  "keywords": [
