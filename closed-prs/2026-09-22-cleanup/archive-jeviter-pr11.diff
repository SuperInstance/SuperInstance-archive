+// src/governor.js — seed 7: the sequential-merge governor
+// (docs/AGENTIC-CYCLE.md: the six patterns' last one, made homeostatic —
+// merge PRs only when their shape stops surprising; the merge queue
+// rests between divergent changes.)
+//
+// This cell does not merge anything. It reads a merge queue the way the
+// fleet reads anything: one at a time, named, and receipted.
+//
+// Doctrine (pinned by tests):
+//   1. SEQUENTIAL: at most one candidate may be admitted per evaluation.
+//      Two mergeable PRs in one sweep is how stacks get silently
+//      reordered — the queue is a single file, not a race.
+//   2. TIP-PINNED: an admitted candidate's base must equal the current
+//      tip. Base drift → HOLD('base-drift'), never a merge onto a stale
+//      tip and never an implicit rebase performed by the governor.
+//   3. UNCHECKED IS NEVER PASS: checks 'pending' → HOLD('unchecked');
+//      'fail' → HOLD('checks-red'). The fleet's lint lesson, applied to
+//      the merge queue itself.
+//   4. HOMEOSTATIC: admit only when the candidate's shape stops
+//      surprising — |shape − mean(admitted)| ≤ k·σ(admitted). A
+//      divergent shape → REST: the whole queue rests, receipted as a
+//      rest, not a hang. Divergent change gets daylight between merges.
+//   5. STACKED: a candidate stacked on an open candidate holds until
+//      its parent admits — order in the stack is load-bearing.
+//   6. Every evaluation books its decisions as hash-chained receipts.
+
+import { Ledger } from './core.js';
+
+export class Governor {
+  constructor({ ledger, k = 2, minHistory = 3 } = {}) {
+    this.ledger = ledger ?? new Ledger('governor');
+    this.k = k;
+    // Shapes of ADMITTED candidates only — refusals and rests must not
+    // move the boundary the next candidate is measured against.
+    this.admittedShapes = [];
+    this.minHistory = minHistory; // below this, admit freely (bootstrap)
+    this.tip = null;
+  }
+
+  threshold() {
+    const hs = this.admittedShapes;
+    if (hs.length < this.minHistory) return null; // bootstrap: no line yet
+    const mean = hs.reduce((a, b) => a + b, 0) / hs.length;
+    const sd = Math.sqrt(hs.reduce((a, b) => a + (b - mean) ** 2, 0) / hs.length);
+    return { mean, sd, limit: mean + this.k * sd };
+  }
+
+  // candidates: [{ id, base, checks: 'pass'|'fail'|'pending',
+  //                shape: number, stackedOn?: id }]
+  // Returns { admit, holds, rest, receipts } — admit is ONE candidate or null.
+  evaluate(candidates) {
+    const seen = new Set();
+    for (const c of candidates) {
+      if (seen.has(c.id)) throw new Error(`duplicate candidate id: ${c.id}`);
+      seen.add(c.id);
+    }
+    const byId = new Map(candidates.map((c) => [c.id, c]));
+    const holds = [];
+    const receipts = [];
+    const rest = [];
+    let admit = null;
+
+    const hold = (c, reason) => {
+      holds.push({ id: c.id, reason });
+      receipts.push(this.ledger.book(c.id, { decision: 'hold', reason }, 'governor'));
+    };
+
+    for (const c of candidates) {
+      // Stack order is load-bearing and outranks everything else:
+      // a child never jumps its parent, admitted this sweep or not.
+      if (c.stackedOn && byId.has(c.stackedOn) && !byId.get(c.stackedOn)._admittedNow) {
+        hold(c, 'stacked'); continue;
+      }
+      if (this.tip != null && c.base !== this.tip) { hold(c, 'base-drift'); continue; }
+      if (c.checks === 'pending') { hold(c, 'unchecked'); continue; }
+      if (c.checks === 'fail') { hold(c, 'checks-red'); continue; }
+      // Sequential gate LAST among the holds: it names the candidate's
+      // own state only after that state would otherwise admit — a red
+      // candidate's receipt says 'checks-red', not 'someone went first'.
+      if (admit) { hold(c, 'sequential-after-admit'); continue; }
+      const t = this.threshold();
+      if (t && Math.abs(c.shape - t.mean) > this.k * t.sd) {
+        rest.push({ id: c.id, shape: c.shape, mean: t.mean, sd: t.sd });
+        receipts.push(this.ledger.book(c.id,
+          { decision: 'rest', shape: c.shape, mean: t.mean, sd: t.sd }, 'governor'));
+        continue;
+      }
+      admit = c;
+      c._admittedNow = true;
+      this.admittedShapes.push(c.shape);
+      receipts.push(this.ledger.book(c.id, { decision: 'admit', shape: c.shape }, 'governor'));
+    }
+    if (admit) this.tip = admit.id; // the admitted candidate IS the new tip
+    return { admit, holds, rest, receipts };
+  }
+
+  // After the admitted candidate actually lands on the remote, confirm
+  // the tip. A governor whose tip is a hope is a target, not a line.
+  confirm(tip) { this.tip = tip; }
+}
+
+export function bookGovernor(ledger, source, result) {
+  return ledger.book(source, {
+    admit: result.admit?.id ?? null,
+    holds: result.holds, rest: result.rest,
+  }, 'governor-reading');
+}
