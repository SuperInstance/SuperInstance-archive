+// test/governor.test.js — seed 7: sequential-merge governor
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { Governor, bookGovernor } from '../src/governor.js';
+import { Ledger } from '../src/core.js';
+
+const cand = (over = {}) => ({
+  id: 'pr-1', base: 'main', checks: 'pass', shape: 100, ...over,
+});
+
+test('sequential: at most one admission even when all are mergeable', () => {
+  const g = new Governor();
+  const r = g.evaluate([cand({ id: 'a' }), cand({ id: 'b' }), cand({ id: 'c' })]);
+  assert.equal(r.admit.id, 'a');                       // first in queue
+  assert.deepEqual(r.holds.map((h) => [h.id, h.reason]),
+    [['b', 'sequential-after-admit'], ['c', 'sequential-after-admit']]);
+  assert.equal(r.rest.length, 0);
+});
+
+test('tip-pinned: base drift holds, never a merge onto a stale tip', () => {
+  const g = new Governor();
+  g.confirm('main');
+  const r = g.evaluate([cand({ id: 'a', base: 'old-tip' })]);
+  assert.equal(r.admit, null);
+  assert.deepEqual(r.holds, [{ id: 'a', reason: 'base-drift' }]);
+});
+
+test('unchecked is never pass; checks-red holds by name', () => {
+  const g = new Governor();
+  const r = g.evaluate([cand({ id: 'a', checks: 'pending' }),
+                        cand({ id: 'b', checks: 'fail' })]);
+  assert.equal(r.admit, null);
+  assert.deepEqual(r.holds.map((h) => h.reason).sort(),
+    ['checks-red', 'unchecked']);
+});
+
+test('homeostatic: a divergent shape rests the queue, receipted not silent', () => {
+  const g = new Governor({ k: 2, minHistory: 3 });
+  // Seed the boundary with three similar admitted shapes. Bases chain
+  // onto each admitted tip — tip-pinning is load-bearing even in fixtures.
+  let base = 'main';
+  for (const s of [100, 101, 99]) {
+    const r = g.evaluate([cand({ id: `seed-${s}`, shape: s, base })]);
+    assert.equal(r.admit.shape, s);
+    base = `seed-${s}`;
+  }
+  const t = g.threshold();
+  assert.ok(t && t.sd < 1);                            // tight history
+  const r = g.evaluate([cand({ id: 'wild', shape: 500, base })]);
+  assert.equal(r.admit, null);
+  assert.equal(r.rest.length, 1);
+  assert.equal(r.rest[0].id, 'wild');
+  assert.ok(r.rest[0].mean > 99 && r.rest[0].mean < 102);
+  assert.ok(Math.abs(500 - r.rest[0].mean) > 2 * r.rest[0].sd);
+  assert.equal(r.receipts.length, 1);                  // the rest is booked
+});
+
+test('refusals and rests do not move the admitted-shape boundary', () => {
+  const g = new Governor({ k: 2, minHistory: 3 });
+  let base = 'main';
+  for (const s of [100, 101, 99]) {
+    g.evaluate([cand({ id: `seed-${s}`, shape: s, base })]);
+    base = `seed-${s}`;
+  }
+  const before = g.threshold().mean;
+  g.evaluate([cand({ id: 'wild', shape: 900, base })]);
+  g.evaluate([cand({ id: 'drift', base: 'elsewhere' })]);
+  assert.equal(g.threshold().mean, before);            // boundary unmoved
+});
+
+test('stacked candidate holds while its parent is held', () => {
+  const g = new Governor();
+  const r = g.evaluate([
+    cand({ id: 'parent', checks: 'fail' }),
+    cand({ id: 'child', stackedOn: 'parent' }),
+  ]);
+  assert.equal(r.admit, null);
+  assert.deepEqual(r.holds, [{ id: 'parent', reason: 'checks-red' },
+                             { id: 'child', reason: 'stacked' }]);
+});
+
+// When the parent admits in the same sweep the child waits its turn
+// behind it — sequential is the reason that matters by then.
+test('stacked candidate waits behind a same-sweep admission', () => {
+  const g = new Governor();
+  const r = g.evaluate([
+    cand({ id: 'parent' }),
+    cand({ id: 'child', stackedOn: 'parent' }),
+  ]);
+  assert.equal(r.admit.id, 'parent');
+  assert.deepEqual(r.holds, [{ id: 'child', reason: 'sequential-after-admit' }]);
+});
+
+test('every decision is a hash-chained receipt; tamper is named at its row', () => {
+  const ledger = new Ledger('governor');
+  const g = new Governor({ ledger });
+  const r = g.evaluate([cand({ id: 'a' }), cand({ id: 'b', checks: 'fail' })]);
+  assert.equal(ledger.entries.length, 2);              // admit + hold
+  assert.ok(ledger.verify());
+  ledger.entries[1].body = ledger.entries[1].body.replace('checks-red', 'checks-ZZZZ');
+  assert.equal(ledger.verify(), false);                // tamper caught
+});
+
+test('duplicate candidate ids throw', () => {
+  const g = new Governor();
+  assert.throws(() => g.evaluate([cand({ id: 'a' }), cand({ id: 'a' })]),
+    /duplicate candidate id/);
+});
+
+test('admission advances the tip for the next evaluation', () => {
+  const g = new Governor();
+  g.confirm('main');
+  const r1 = g.evaluate([cand({ id: 'a' })]);
+  assert.equal(r1.admit.id, 'a');
+  // Next candidate must base on 'a' now — the governor's tip is real.
+  const r2 = g.evaluate([cand({ id: 'b', base: 'a' })]);
+  assert.equal(r2.admit.id, 'b');
+  const r3 = g.evaluate([cand({ id: 'c', base: 'main' })]);
+  assert.equal(r3.admit, null);
+  assert.deepEqual(r3.holds, [{ id: 'c', reason: 'base-drift' }]);
+});
+
+test('bookGovernor books the reading replayable', () => {
+  const ledger = new Ledger('governor');
+  const g = new Governor({ ledger });
+  const r = g.evaluate([cand({ id: 'a' })]);
+  bookGovernor(ledger, 'sweep-1', r);
+  const last = JSON.parse(ledger.entries.at(-1).body);
+  assert.equal(last.kind, 'governor-reading');
+  assert.equal(last.state, 'sweep-1');
+  assert.equal(JSON.parse(last.payload).admit, 'a');
+  assert.ok(ledger.verify());
+});
