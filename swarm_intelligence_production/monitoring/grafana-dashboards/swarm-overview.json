{
  "dashboard": {
    "title": "Swarm Intelligence - Overview",
    "uid": "swarm-overview",
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "10s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Total Active Agents",
        "type": "stat",
        "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "sum(swarm_agents_total)",
            "legendFormat": "Agents",
            "refId": "A"
          }
        ],
        "options": {
          "graphMode": "area",
          "colorMode": "value",
          "justifyMode": "center",
          "textMode": "value_and_name"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 100000, "color": "yellow"},
                {"value": 1000000, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Average FPS",
        "type": "stat",
        "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "avg(swarm_fps)",
            "legendFormat": "FPS",
            "refId": "A"
          }
        ],
        "options": {
          "graphMode": "area",
          "colorMode": "value"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 30, "color": "yellow"},
                {"value": 60, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Memory Usage",
        "type": "stat",
        "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "sum(container_memory_working_set_bytes{namespace=\"swarm-intelligence\",container=\"swarm-core\"}) / 1024 / 1024 / 1024",
            "legendFormat": "Memory (GB)",
            "refId": "A"
          }
        ],
        "options": {
          "graphMode": "area",
          "colorMode": "value"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "decgbytes",
            "decimals": 2,
            "thresholds": {
              "mode": "percentage",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 70, "color": "yellow"},
                {"value": 85, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "Active Swarms",
        "type": "stat",
        "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "swarm_active_swarms_total",
            "legendFormat": "Swarms",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 5,
        "title": "Agents Over Time",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "sum(swarm_agents_total)",
            "legendFormat": "Total Agents",
            "refId": "A"
          },
          {
            "expr": "sum(swarm_agents_total) by (behavior)",
            "legendFormat": "{{behavior}}",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 10,
              "showPoints": "never"
            },
            "unit": "short"
          }
        }
      },
      {
        "id": 6,
        "title": "FPS by Pod",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "swarm_fps",
            "legendFormat": "{{pod}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth"
            },
            "unit": "short",
            "min": 0,
            "max": 120
          },
          "overrides": [
            {
              "matcher": {"id": "byName"},
              "properties": [
                {
                  "id": "custom.lineWidth",
                  "value": 2
                }
              ]
            }
          ]
        }
      },
      {
        "id": 7,
        "title": "Agent Processing Latency (p95)",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(swarm_processing_duration_seconds_bucket[5m])) by (le))",
            "legendFormat": "p95 Latency",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(swarm_processing_duration_seconds_bucket[5m])) by (le))",
            "legendFormat": "p99 Latency",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth"
            }
          }
        }
      },
      {
        "id": 8,
        "title": "Task Completion Rate",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(swarm_tasks_completed_total[5m])",
            "legendFormat": "Tasks/sec",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 30
            }
          }
        }
      },
      {
        "id": 9,
        "title": "Pod CPU Usage",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 20, "w": 8, "h": 8},
        "targets": [
          {
            "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"swarm-intelligence\",container=\"swarm-core\"}[5m])) by (pod)",
            "legendFormat": "{{pod}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "custom": {
              "drawStyle": "line",
              "stacking": {"mode": "normal"}
            }
          }
        }
      },
      {
        "id": 10,
        "title": "Pod Memory Usage",
        "type": "timeseries",
        "gridPos": {"x": 8, "y": 20, "w": 8, "h": 8},
        "targets": [
          {
            "expr": "sum(container_memory_working_set_bytes{namespace=\"swarm-intelligence\",container=\"swarm-core\"}) by (pod) / 1024 / 1024 / 1024",
            "legendFormat": "{{pod}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "decgbytes",
            "custom": {
              "drawStyle": "line",
              "stacking": {"mode": "normal"}
            }
          }
        }
      },
      {
        "id": 11,
        "title": "Network I/O",
        "type": "timeseries",
        "gridPos": {"x": 16, "y": 20, "w": 8, "h": 8},
        "targets": [
          {
            "expr": "sum(rate(container_network_receive_bytes_total{namespace=\"swarm-intelligence\"}[5m]))",
            "legendFormat": "Receive",
            "refId": "A"
          },
          {
            "expr": "sum(rate(container_network_transmit_bytes_total{namespace=\"swarm-intelligence\"}[5m]))",
            "legendFormat": "Transmit",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "Bps",
            "custom": {
              "drawStyle": "line"
            }
          }
        }
      },
      {
        "id": 12,
        "title": "Pheromone Updates",
        "type": "gauge",
        "gridPos": {"x": 0, "y": 28, "w": 6, "h": 6},
        "targets": [
          {
            "expr": "rate(swarm_pheromone_updates_total[5m])",
            "legendFormat": "Updates/sec",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 10000, "color": "yellow"},
                {"value": 50000, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 13,
        "title": "Voting Activity",
        "type": "gauge",
        "gridPos": {"x": 6, "y": 28, "w": 6, "h": 6},
        "targets": [
          {
            "expr": "rate(swarm_voting_rounds_total[5m])",
            "legendFormat": "Votes/sec",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 100, "color": "yellow"}
              ]
            }
          }
        }
      },
      {
        "id": 14,
        "title": "Pod Count by Deployment",
        "type": "bargauge",
        "gridPos": {"x": 12, "y": 28, "w": 6, "h": 6},
        "targets": [
          {
            "expr": "count(kube_pod_status_phase{namespace=\"swarm-intelligence\",phase=\"Running\"}) by (deployment)",
            "legendFormat": "{{deployment}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        }
      },
      {
        "id": 15,
        "title": "HPA Current vs Desired",
        "type": "bargauge",
        "gridPos": {"x": 18, "y": 28, "w": 6, "h": 6},
        "targets": [
          {
            "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"swarm-intelligence\"}",
            "legendFormat": "{{horizontalpodautoscaler}} (current)",
            "refId": "A"
          },
          {
            "expr": "kube_horizontalpodautoscaler_status_desired_replicas{namespace=\"swarm-intelligence\"}",
            "legendFormat": "{{horizontalpodautoscaler}} (desired)",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        }
      }
    ]
  }
}
